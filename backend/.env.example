# ---------------------------------------------------------------------------
# AI Finance Assistant - backend environment template
# Copy to `.env` and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME="AI Finance Assistant"
ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-16-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Local development (SQLite, no server required) ------------------------
# Leave DATABASE_URL unset to use backend/finance.db automatically.
# DATABASE_URL=sqlite:///./finance.db
AUTO_CREATE_TABLES=true

# --- Local PostgreSQL -------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_finance

# --- Supabase PostgreSQL (session pooler, port 5432 or 6543) ----------------
# Use the connection string from Supabase Dashboard > Project Settings > Database.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Machine learning -------------------------------------------------------
AUTO_TRAIN_ON_STARTUP=true
MIN_FORECAST_MONTHS=4
# CATEGORY_MODEL_PATH=ml/artifacts/category_classifier.joblib
# CATEGORY_METADATA_PATH=ml/artifacts/category_model_metadata.json
# CATEGORY_EVALUATION_PATH=ml/artifacts/category_evaluation.json
# TRAINING_DATASET_PATH=ml/dataset/transactions_training_data.csv
